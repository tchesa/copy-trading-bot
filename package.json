{
  "name": "shadow-wallets",
  "version": "0.1.0",
  "private": true,
  "description": "Solana copy-trading research: wallet persistence, delayed-follower replication and walk-forward portfolio backtest",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "spike": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/spike.ts",
    "backfill": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/backfill.ts",
    "study": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/study.ts",
    "sweep": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/sweep.ts",
    "baselines": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/baselines.ts",
    "check-data": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/audit.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
